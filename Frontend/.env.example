# TruEntry frontend environment

# ---------------------------------------------------------------------------
# API
# The app calls the API at /api/v1 on its own domain.
#  • Deployed (Vercel): vercel.json forwards /api/* to the backend. Nothing to
#    set. (VITE_API_URL is ignored in production builds so the sign-in cookie
#    stays first-party; set VITE_API_DIRECT=true only to opt out.)
#  • Local dev: the Vite dev server forwards /api/* to VITE_PROXY_TARGET.
#      VITE_PROXY_TARGET=http://localhost:5000            # local backend
#      VITE_PROXY_TARGET=https://tru-entry.vercel.app      # deployed backend (default)
#    VITE_API_URL can still point dev at an absolute URL if you need it.
# ---------------------------------------------------------------------------
# VITE_PROXY_TARGET=http://localhost:5000
# VITE_API_URL=
# VITE_API_DIRECT=false

VITE_APP_NAME=TruEntry
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public
