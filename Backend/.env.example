# ==========================================================================
# TruEntry Backend — Environment Configuration
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file to version control.
# ==========================================================================

# ---- Core ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=TruEntry

# Public URLs (used in emails, letters, redirects, CORS)
FRONTEND_URL=https://truentry-frontend.vercel.app
ADMIN_URL=https://www.truentry.org/admin
BACKEND_URL=https://tru-entry.vercel.app

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://truentry-frontend.vercel.app,https://truentry.org,https://www.truentry.org,http://localhost:3000,http://localhost:5173

# ---- Database (Supabase Postgres) ----
# LOCAL dev: either the direct or the pooled connection string works.
#
# VERCEL / any serverless host: you MUST use the POOLED (Supavisor, transaction
# mode) string. The DIRECT host (db.<ref>.supabase.co) is IPv6-only and is NOT
# reachable from Vercel — it fails at runtime with:
#     getaddrinfo ENOTFOUND db.<ref>.supabase.co
# Get the pooled string from Supabase:
#   Project Settings > Database > Connection string > "Connection pooling" (Transaction).
# Pooled format — note the host contains "pooler" and the port is 6543:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Set to "true" for Supabase (SSL required).
DATABASE_SSL=true

# ---- Supabase (Storage buckets: profile images, policy pdfs, admission letters, reports) ----
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_PROFILES=profile-images
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_LETTERS=admission-letters
SUPABASE_BUCKET_REPORTS=reports

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10

# ---- Email (Resend) ----
RESEND_API_KEY=xxxxxx
MAIL_FROM_NAME=TruEntry
MAIL_FROM_EMAIL=support@truentry.org
MAIL_SUPPORT_EMAIL=support@truentry.org

# ---- Payments (Paystack) ----
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public
PAYSTACK_BASE_URL=https://api.paystack.co
# Default application fee in Naira (kobo is computed internally)
APPLICATION_FEE_NGN=2500
PAYSTACK_CALLBACK_URL=https://truentry-frontend.vercel.app/payment/callback

# ---- NIN Validation (Dojah) ----
DOJAH_APP_ID=your-dojah-app-id
DOJAH_SECRET_KEY=your-dojah-secret-key
DOJAH_BASE_URL=https://api.dojah.io
# When true, NIN service returns deterministic mock data (no external call)
DOJAH_MOCK=true

# ---- AI Chatbot (OpenAI) ----
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MOCK=false

# ---- Stubbed regulator APIs (JAMB / WAEC / NECO / NABTEB) ----
# These serve seeded demo data until official access is granted.
JAMB_API_MODE=stub
WAEC_API_MODE=stub
JAMB_API_BASE_URL=
JAMB_API_KEY=
WAEC_API_BASE_URL=
WAEC_API_KEY=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Seed / bootstrap super admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@truentry.org
SEED_ADMIN_PASSWORD=ChangeMe_Admin123!
SEED_ADMIN_NAME=System Administrator
